{
    "root": true,
    "api": {
        "projectId": "lpyhhrcy",
        "dataset": "production"
    },
    "project": {
        "name": "SPFO"
    },
    "plugins": [
        "@sanity/base",
        "@sanity/default-layout",
        "@sanity/default-login",
        "@sanity/desk-tool",
        "better-slug",
        "asset-source-unsplash",
        "@sanity/production-preview",
        "webhook-deploy",
        "iframe-pane",
        "media"
    ],
    "env": {
        "development": {
            "plugins": ["@sanity/vision"]
